    "import apis.events.client_models.event_model as em\n",
    "import apis.events.event_record as er\n",
    "import apis.events.events_mapper as ema"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "47874bce",
   "metadata": {},
   "outputs": [],
   "source": [
    "endpoint = \"/events.json\"\n",
    "kword_filters_gb= {\"keyword\":\"festival\", \"countryCode\":\"GB\"}\n",
    "kword_filters_uk= {\"keyword\":\"festival\", \"countryCode\":\"UK\"}\n",
    "\n",
    "response_data_gb = tm.get_ticketmaster_data(endpoint, filters=kword_filters_gb)\n",
    "response_data_uk = tm.get_ticketmaster_data(endpoint, filters=kword_filters_uk)\n",
    "print(response_data_gb)\n",
    "events_gb = response_data_gb.get(\"_embedded\", {}).get(\"events\", [])\n",
    "events_uk = response_data_uk.get(\"_embedded\", {}).get(\"events\", [])\n",
    "events_list = events_gb + events_uk\n",
    "events_list[0].keys()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f0bdcb4f",
   "metadata": {},
   "outputs": [],
   "source": [
    "new_items = [em.Event.model_validate(item) for item in events_list]\n",
    "eventsmapper = ema.EventMapper()\n",
    "newnew_items = [eventsmapper.map_event_to_record(event=item) for item in new_items]\n",
    "for item in newnew_items:\n",
    "    print(item)"
