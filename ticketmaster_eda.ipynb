   "source": [
    "from apis import skiddle as sk\n",
    "from pprint import pprint\n",
    "\n",
    "import pandas as pd\n",
    "from math import ceil"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ecd45102",
   "metadata": {},
   "outputs": [],
   "source": [
    "endpoint = 'events/search/'\n",
    "filters = {\n",
    "    'country': 'GB',\n",
    "    'eventcode': 'FEST'\n",
    "}\n",
    "\n",
    "results = sk.fetch_all_events(filters,verbose=True)\n",
    "len(results)\n",
    "\n",
    "# data = sk.query(endpoint, filters=filters, verbose=True)\n",
    "# results = data['results']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e2d7d1f6",
   "metadata": {},
   "outputs": [],
   "source": [
    "keys = ['id','listingid','eventname','startdate','enddate']\n",
    "df = pd.DataFrame([{key: r.get(key, None) for key in keys} for r in results])\n",
    "df['startdate'] = pd.to_datetime(df['startdate'])\n",
    "df['enddate'] = pd.to_datetime(df['enddate'])\n",
    "\n",
    "print(f\"Total rows: {len(df)}\")\n",
    "df.head()"
   ]
